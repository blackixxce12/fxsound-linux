# Maintainer: FxSound Linux port contributors
#
# Builds the port from the working tree next to this file, so it is meant to be run as
#
#     cd packaging && makepkg -f
#
# rather than fetched from a remote. Install the result with `pacman -U`.

pkgname=fxsound-linux
pkgver=0.3.0
pkgrel=1
pkgdesc="System-wide audio enhancement for Linux: EQ, ambience, surround, bass and dynamic boost (Rust/egui port of FxSound)"
arch=('x86_64')
url="https://github.com/blackixxce12/fxsound-linux"
license=('AGPL-3.0-or-later')
# Runtime: PipeWire for audio, the Wayland/GL stack for the window, D-Bus for the tray and
# notifications, fontconfig because egui asks it for fallback faces.
depends=('pipewire' 'libpipewire' 'wayland' 'libxkbcommon' 'libglvnd' 'fontconfig' 'dbus'
         'hicolor-icon-theme')   # the icons install into its tree
# `clang` is not optional: pipewire-sys runs bindgen in its build script and fails with
# "Unable to find libclang" without it. The build only appears to work without it on a machine
# that happens to have clang installed for something else — a clean chroot does not.
makedepends=('rust' 'cargo' 'pkgconf' 'clang')
optdepends=(
  'wireplumber: session management, needed to switch the default sink'
  'xdg-desktop-portal: native file dialogs for preset import and export'
  'xdg-desktop-portal-gtk: a file-chooser backend for those dialogs (or -kde, -gnome)'
  'libnotify: desktop notifications'
)
provides=('fxsound')
conflicts=('fxsound')
options=('!lto')   # the workspace already sets `lto = "thin"` in its release profile
source=()
sha256sums=()

_srcdir="$(cd "${startdir}/.." && pwd)"

# rust-toolchain.toml pins channel = "1.98.1", which only rustup's proxies read: Arch's own
# cargo ignores it (and RUSTUP_TOOLCHAIN with it), which is the case this recipe was written for.
# On a machine that builds with rustup the pin would make the proxy download 1.98.1, so the
# variable steers it to an installed channel instead — but only when the caller has not already
# chosen one: CI sets RUSTUP_TOOLCHAIN=1.98.1 and expects it honoured.
_toolchain="${RUSTUP_TOOLCHAIN:-stable}"

prepare() {
  cd "${_srcdir}"
  export RUSTUP_TOOLCHAIN="${_toolchain}"
  # build() and check() run --frozen, which refuses to touch the network, so the registry has to be
  # filled in here where makepkg allows it. On a machine that has built the tree before this is a
  # no-op; in a clean chroot or a container it is the difference between a build and an error.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_srcdir}"
  export RUSTUP_TOOLCHAIN="${_toolchain}"
  export CARGO_TARGET_DIR="${_srcdir}/target"
  cargo build --release --frozen --bin fxsound
}

check() {
  cd "${_srcdir}"
  export RUSTUP_TOOLCHAIN="${_toolchain}"
  export CARGO_TARGET_DIR="${_srcdir}/target"
  # Nothing here touches the live PipeWire graph or the user's settings file.
  cargo test --release --frozen --workspace
}

package() {
  cd "${_srcdir}"

  install -Dm755 "target/release/fxsound" "${pkgdir}/usr/bin/fxsound"

  # Factory and bonus presets. `PresetStore::with_default_dirs` looks here first when the binary
  # is installed rather than run out of the source tree.
  # Only the presets themselves: the upstream folder also carries a zip of the same files and a
  # stray text file, and neither belongs in a package.
  for _dir in Factsoft BonusPresets; do
    install -d "${pkgdir}/usr/share/fxsound/presets/${_dir}"
    install -Dm644 "assets/presets/${_dir}"/*.fac \
      -t "${pkgdir}/usr/share/fxsound/presets/${_dir}/"
  done

  # The voice presets, which are TOML rather than .fac because they describe the microphone chain
  # and a .fac has nowhere to put a gate threshold.
  install -d "${pkgdir}/usr/share/fxsound/presets/Input"
  install -Dm644 assets/presets/Input/*.toml \
    -t "${pkgdir}/usr/share/fxsound/presets/Input/"

  install -Dm644 "packaging/fxsound.desktop" \
    "${pkgdir}/usr/share/applications/com.fxsound.FxSound.desktop"

  # The systemd user unit, so `systemctl --user enable --now fxsound` works on an installed
  # package rather than failing with "Unit not found".
  install -Dm644 "packaging/fxsound.service" \
    "${pkgdir}/usr/lib/systemd/user/fxsound.service"
  install -Dm644 "assets/images/fxsound_large.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/fxsound.png"
  install -Dm644 "assets/images/fxsound.png" \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/fxsound.png"

  # The tray icon's three states. A StatusNotifier host resolves an icon *name* through the theme,
  # so without these under hicolor's status context the tray shows a blank where the icon should
  # be — which is exactly what every 0.3.0 package did.
  install -Dm644 assets/icons/status/com.fxsound.FxSound-{off,on,processing}.svg \
    -t "${pkgdir}/usr/share/icons/hicolor/scalable/status/"

  # The unit says Documentation=man:fxsound(1); shipping the page is what makes that line true.
  install -Dm644 "packaging/fxsound.1" "${pkgdir}/usr/share/man/man1/fxsound.1"

  # AppStream metadata, so GNOME Software and Discover list the application at all.
  install -Dm644 "packaging/com.fxsound.FxSound.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/com.fxsound.FxSound.metainfo.xml"

  # The compositor rules and the keybind examples: a Wayland client cannot grab global shortcuts,
  # so the bindings live in the compositor and call back into the running instance.
  install -Dm644 "packaging/hyprland.conf.example" \
    "${pkgdir}/usr/share/doc/${pkgname}/hyprland.conf.example"
  install -Dm644 "packaging/fxsound-autostart.desktop" \
    "${pkgdir}/usr/share/doc/${pkgname}/fxsound-autostart.desktop"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "CHANGELOG.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"

  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
